.page {
  padding: 30rpx 40rpx 0;
}

/* 等级卡 */
.level-card {
  background: linear-gradient(135deg, #6C5CE7, #8F7BFF);
  border-radius: 24rpx;
  padding: 36rpx 34rpx;
  color: #fff;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(108, 92, 231, 0.3);
}

.level-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.level-name {
  font-size: 36rpx;
  font-weight: bold;
}

.level-total {
  font-size: 24rpx;
  opacity: 0.85;
}

.bar {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #FFD166;
  border-radius: 8rpx;
  transition: width 0.3s;
}

.level-next {
  margin-top: 18rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 统计网格 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.stat-card {
  width: 48%;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 0;
  text-align: center;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #6C5CE7;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

/* 最近求签 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 34rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.empty {
  font-size: 26rpx;
  color: #a49bd6;
  padding: 20rpx 0;
}

.empty:active {
  opacity: 0.6;
}

.h-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f4f4f4;
}

.h-item:last-child {
  border-bottom: none;
}

.h-badge {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  margin-right: 20rpx;
}

.h-text {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.h-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #bbb;
  margin-left: 16rpx;
}

.lv5 { color: #E53935; background: #FFEBEE; }
.lv4 { color: #EF6C00; background: #FFF3E0; }
.lv3 { color: #2E7D32; background: #E8F5E9; }
.lv2 { color: #00897B; background: #E0F2F1; }
.lv1 { color: #78909C; background: #ECEFF1; }

/* 设置 */
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}

.set-label {
  font-size: 28rpx;
  color: #333;
}

/* 成就墙 */
.ach-count {
  font-size: 22rpx;
  color: #bbb;
  font-weight: normal;
  margin-left: 12rpx;
}

.ach-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 12rpx;
}

.ach-item {
  width: 31.5%;
  background: #F7F5FC;
  border-radius: 16rpx;
  padding: 22rpx 0 16rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.ach-item.on {
  background: #F0ECFF;
}

.ach-item.new {
  animation: newGlow 1s infinite alternate;
}

@keyframes newGlow {
  from { box-shadow: 0 0 0 0 rgba(255, 209, 102, 0); }
  to { box-shadow: 0 0 0 6rpx rgba(255, 209, 102, 0.7); }
}

.ach-emoji {
  font-size: 48rpx;
  line-height: 1.2;
}

.ach-item.off .ach-emoji {
  font-size: 36rpx;
  filter: grayscale(1);
  opacity: 0.7;
}

.ach-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
  margin-top: 8rpx;
}

.ach-item.off .ach-name {
  color: #999;
  font-weight: normal;
}

.ach-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
  padding: 0 8rpx;
}

/* 解锁弹窗 */
.ach-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 30, 70, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.ach-panel {
  width: 560rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  animation: achPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes achPop {
  from { transform: scale(0.6); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.ach-panel-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.ach-panel-item {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  background: #F0ECFF;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  animation: achPop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.ach-panel-emoji {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.ach-panel-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #6C5CE7;
}

.ach-panel-tip {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 28rpx;
}

/* 底部 */
.reset {
  margin-top: 10rpx;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
  padding: 20rpx 0;
}

.reset.disabled {
  color: #e3e3e3;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: #ccc;
  padding: 20rpx 0 10rpx;
}
