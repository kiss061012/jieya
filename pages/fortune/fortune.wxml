<view class="page">
  <view class="stage-card">
    <view class="lantern l">🏮</view>
    <view class="lantern r">🏮</view>

    <block wx:if="{{state === 'idle'}}">
      <view class="taiji">☯</view>
      <view class="stage-title">今日求一签</view>
      <view class="stage-sub">心诚则灵 · 每日仅可求一签</view>
      <view class="tube-wrap" bindtap="draw">
        <view class="sticks">
          <view class="stick s1"></view>
          <view class="stick s2"></view>
          <view class="stick s3"></view>
          <view class="stick s4"></view>
          <view class="stick s5"></view>
        </view>
        <view class="tube"></view>
      </view>
    </block>

    <block wx:elif="{{state === 'shaking'}}">
      <view class="taiji spinning">☯</view>
      <view class="stage-title">签筒摇晃中...</view>
      <view class="stage-sub">心诚则灵 · 静候天意</view>
      <view class="tube-wrap shaking">
        <view class="sticks">
          <view class="stick s1"></view>
          <view class="stick s2"></view>
          <view class="stick s3"></view>
          <view class="stick s4"></view>
          <view class="stick s5"></view>
        </view>
        <view class="tube"></view>
      </view>
    </block>

    <block wx:elif="{{state === 'falling'}}">
      <view class="stage-title">签掉出来了！</view>
      <view class="stage-sub">啪嗒一声，落在地上</view>
      <view class="tube-wrap popped">
        <view class="sticks">
          <view class="stick s1"></view>
          <view class="stick s2"></view>
          <view class="stick s4"></view>
          <view class="stick s5"></view>
        </view>
        <view class="tube"></view>
      </view>
      <view class="fall-area">
        <view class="fall-stick">
          <view class="stick-body"></view>
          <view class="stick-cap"></view>
        </view>
        <view class="dust d1"></view>
        <view class="dust d2"></view>
      </view>
    </block>

    <block wx:else>
      <view class="result">
        <view class="fallen">
          <view class="fall-area">
            <view class="fall-stick rest">
              <view class="stick-body"></view>
              <view class="stick-cap"></view>
            </view>
          </view>
        </view>
        <view class="scroll">
          <view class="scroll-cap left"></view>
          <view class="scroll-cap right"></view>
          <view class="scroll-line">{{fortune.emoji}} 第{{fortune.num}}签 · {{fortune.gua}}卦</view>
          <view class="scroll-name">{{fortune.name}}</view>
          <view class="scroll-text">{{fortune.text}}</view>
        </view>
        <view class="seal">{{fortune.name === '小凶' ? '凶' : '吉'}}</view>
        <view class="done-tip" wx:if="{{drawnToday}}">🕯️ 今日一签已求，明日再来</view>
      </view>
    </block>
  </view>

  <view class="history-card">
    <view class="history-title">签文记录</view>
    <view class="history-empty" wx:if="{{!history.length}}">还没有求过签，快去抽一支吧</view>
    <view class="history-item" wx:for="{{history}}" wx:key="time">
      <view class="h-badge lv{{item.level}}">{{item.name}}</view>
      <view class="h-text">{{item.text}}</view>
      <view class="h-time">{{item.timeText}}</view>
    </view>
  </view>

  <view class="tabbar-holder"></view>
</view>

