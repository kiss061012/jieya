.page {
  padding: 30rpx 40rpx 0;
}

/* 顶部计分卡 */
.head-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 34rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.head-row {
  display: flex;
  align-items: center;
}

.head-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.combo-badge {
  margin-left: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #FF6B35;
  animation: comboPulse 0.5s ease-in-out infinite;
}

@keyframes comboPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}

.head-score {
  margin-left: auto;
  font-size: 24rpx;
  color: #999;
}

.score-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #FF9F1C;
}

.head-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.pbar {
  margin-top: 16rpx;
  height: 10rpx;
  background: #F0EDFA;
  border-radius: 5rpx;
  overflow: hidden;
}

.pbar-fill {
  height: 100%;
  background: linear-gradient(90deg, #6C5CE7, #FFD166);
  border-radius: 5rpx;
  transition: width 0.2s;
}

.praise {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6C5CE7;
  font-weight: bold;
  animation: praiseIn 0.35s ease-out;
}

@keyframes praiseIn {
  from { opacity: 0; transform: translateY(-12rpx) scale(0.85); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* 泡泡纸 */
.bubble-card {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  padding: 34rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.bubble-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.bubble {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 -10rpx 18rpx rgba(0, 0, 0, 0.08), 0 6rpx 12rpx rgba(0, 0, 0, 0.06);
}

.c0 { background: linear-gradient(135deg, #FFC3D0, #FF9EB5); }
.c1 { background: linear-gradient(135deg, #BDEFFA, #8FDCF2); }
.c2 { background: linear-gradient(135deg, #FFF3B8, #FFE27A); }

/* 彩蛋泡泡：金色脉动 */
.bubble.egg {
  background: linear-gradient(135deg, #FFF0A0, #F5B800);
  box-shadow: inset 0 -10rpx 18rpx rgba(0, 0, 0, 0.1), 0 0 16rpx rgba(245, 184, 0, 0.7);
  animation: eggPulse 1.2s ease-in-out infinite;
}

@keyframes eggPulse {
  0%, 100% { transform: scale(1); box-shadow: inset 0 -10rpx 18rpx rgba(0, 0, 0, 0.1), 0 0 14rpx rgba(245, 184, 0, 0.55); }
  50% { transform: scale(1.08); box-shadow: inset 0 -10rpx 18rpx rgba(0, 0, 0, 0.1), 0 0 26rpx rgba(245, 184, 0, 0.95); }
}

.egg-mark {
  font-size: 34rpx;
  line-height: 1;
  animation: eggTwinkle 0.9s ease-in-out infinite alternate;
}

@keyframes eggTwinkle {
  from { opacity: 0.45; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1.1); }
}

.bubble.popped {
  background: #EFEFF5;
  box-shadow: none;
  opacity: 0.35;
  transform: scale(0.82);
  animation: pop 0.18s ease-out;
}

@keyframes pop {
  0% { transform: scale(1.15); }
  100% { transform: scale(0.82); }
}

.burst {
  font-size: 40rpx;
  line-height: 1;
  animation: burstIn 0.4s ease-out forwards;
}

@keyframes burstIn {
  0% { transform: scale(0.2); opacity: 1; }
  100% { transform: scale(1.9); opacity: 0; }
}

/* 彩蛋金光 */
.egg-flash {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 24rpx;
  pointer-events: none;
  background: radial-gradient(circle at 50% 42%, rgba(255, 224, 102, 0.9), rgba(255, 224, 102, 0) 70%);
  animation: eggFlash 0.5s ease-out forwards;
  z-index: 1;
}

@keyframes eggFlash {
  0% { opacity: 0; }
  30% { opacity: 1; }
  100% { opacity: 0; }
}

/* 结算遮罩 */
.overlay {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

/* 烟花 */
.fireworks {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 0;
  height: 0;
  z-index: 3;
}

.fw {
  position: absolute;
}

.fp {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  opacity: 0;
  animation: fw 0.9s ease-out forwards;
}

@keyframes fw {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  100% { transform: translate(0, -240rpx) scale(0.25); opacity: 0; }
}

.overlay-box {
  text-align: center;
}

.overlay-emoji {
  font-size: 100rpx;
  animation: twinkle 1s ease-in-out infinite alternate;
}

@keyframes twinkle {
  from { transform: scale(1); opacity: 1; }
  to { transform: scale(1.15); opacity: 0.85; }
}

.overlay-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin: 16rpx 0 8rpx;
}

/* 结算 */
.settle-row {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin: 8rpx 0 18rpx;
}

.settle-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.settle-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #6C5CE7;
}

.settle-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #999;
}

.rating {
  display: inline-block;
  padding: 10rpx 36rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  animation: praiseIn 0.4s ease-out 0.2s both;
}

.rating-s { color: #8A6D00; background: linear-gradient(135deg, #FFE27A, #FFD166); }
.rating-a { color: #fff; background: linear-gradient(135deg, #6C5CE7, #8F7BFF); }
.rating-b { color: #fff; background: linear-gradient(135deg, #4D96FF, #74B9FF); }
.rating-c { color: #666; background: #EFEFF5; }

.new-best {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #F5B800;
  animation: bestPop 0.5s ease-out 0.4s both;
}

@keyframes bestPop {
  0% { opacity: 0; transform: scale(0.4); }
  60% { transform: scale(1.25); }
  100% { opacity: 1; transform: scale(1); }
}

.best-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 18rpx 60rpx;
  background: linear-gradient(135deg, #6C5CE7, #8F7BFF);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(108, 92, 231, 0.35);
}

.btn-reset {
  margin-top: 30rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6C5CE7;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}
